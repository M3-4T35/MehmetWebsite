# -------------------------------------------------------------------
# MEHMET WEBSITE - CONFIGURATION DE L'ENVIRONNEMENT
# -------------------------------------------------------------------
# Ne définissez pas de secrets de production dans ce fichier.
# Utilisez .env.local pour vos configurations personnelles.

###> SYMFONY CORE ###
APP_ENV=dev
APP_DEBUG=0
APP_SECRET=0000
###< SYMFONY CORE ###

###> BASE DE DONNÉES ###
# PostgreSQL (avec Doctrine) :
#
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/dbname?serverVersion=16&charset=utf8"
###> symfony/mailer ###
#MAILER_DSN=*
###< symfony/mailer ###
# MySQL / MariaDB :
DATABASE_URL="mysql://user:password@127.0.0.1:3306/dbname?serverVersion=8.0.32&charset=utf8mb4"

# SQLite :
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< BASE DE DONNÉES ###

###> SERVEUR DE MAIL (SMTP) ###
# Utilisé pour la réinitialisation de mot de passe.
# Exemple Gmail : gmail://USERNAME:PASSWORD@default
# Exemple Mailtrap : smtp://USERNAME:PASSWORD@sandbox.smtp.mailtrap.io:2525
MAILER_DSN=null://default
###< SERVEUR DE MAIL (SMTP) ###
