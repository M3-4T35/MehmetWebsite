{# Kept free of database access and layout dependencies: this page must render even when the site is broken. #}
<!DOCTYPE html>
<html lang="{{ app.request ? app.request.locale : 'fr' }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex">
        <title>{{ 'error.generic.title'|trans }} | MehmetAtes.fr</title>
        <style>
            body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; background: #f8f9fa; color: #212529; }
            main { max-width: 32rem; padding: 2rem; }
            h1 { font-size: 1.75rem; margin: 0 0 0.75rem; }
            p { line-height: 1.6; margin: 0 0 1.5rem; }
            a { color: #0d6efd; }
            @media (prefers-color-scheme: dark) { body { background: #181a1b; color: #f8f9fa; } a { color: #6ea8fe; } }
        </style>
    </head>
    <body>
        <main>
            <h1>{{ 'error.generic.title'|trans }}</h1>
            <p>{{ 'error.generic.text'|trans }}</p>
            <a href="/">{{ 'error.home'|trans }}</a>
        </main>
    </body>
</html>
