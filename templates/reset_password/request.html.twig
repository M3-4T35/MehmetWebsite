{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe | Mehmet ATES{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-shield-lock fs-1 text-primary"></i>
                    </div>
                    <h2 class="fw-bold h4">Mot de passe oublié</h2>
                    <p class="text-muted small">Entrez votre email pour recevoir un lien de réinitialisation.</p>
                </div>

                {% for flash_error in app.flashes('reset_password_error') %}
                    <div class="alert alert-danger border-0 small mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>{{ flash_error }}
                    </div>
                {% endfor %}

                {{ form_start(requestForm) }}
                    <div class="mb-4">
                        {{ form_row(requestForm.email, {
                            'label': 'Votre adresse email',
                            'attr': {'class': 'form-control bg-light border-0', 'placeholder': 'votre@email.fr'}
                        }) }}
                        <div class="form-text small mt-2">
                            <i class="bi bi-info-circle me-1"></i> Nous vous enverrons un lien sécurisé par email.
                        </div>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-primary btn-lg rounded-pill fw-bold py-2 shadow-sm">
                            Envoyer le mail <i class="bi bi-send-fill ms-2 small"></i>
                        </button>
                    </div>
                {{ form_end(requestForm) }}
            </div>
        </div>
        
        <div class="text-center mt-4">
            <a href="{{ path('app_login') }}" class="btn btn-link text-muted text-decoration-none btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Retour à la connexion
            </a>
        </div>
    </div>
</div>
{% endblock %}
