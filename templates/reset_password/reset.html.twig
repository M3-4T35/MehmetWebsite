{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe | Mehmet ATES{% endblock %}

{% block body %}
<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                        <i class="bi bi-key-fill fs-1 text-success"></i>
                    </div>
                    <h2 class="fw-bold h4">Nouveau mot de passe</h2>
                    <p class="text-muted small">Veuillez choisir un mot de passe robuste.</p>
                </div>

                {{ form_start(resetForm) }}
                    <div class="mb-4 reset-password-form">
                        {{ form_row(resetForm.plainPassword, {
                            'label': false
                        }) }}
                    </div>
                    
                    <div class="d-grid">
                        <button class="btn btn-success btn-lg rounded-pill fw-bold py-2 shadow-sm">
                            Mettre à jour <i class="bi bi-check-circle-fill ms-2 small"></i>
                        </button>
                    </div>
                {{ form_end(resetForm) }}
            </div>
        </div>
    </div>
</div>

<style>
    /* Fix for Symfony default password constraints display */
    .reset-password-form ul {
        list-style: none;
        padding-left: 0;
        font-size: 0.8rem;
        color: var(--bs-danger);
        margin-top: 5px;
    }
    .reset-password-form input {
        background-color: var(--bs-tertiary-bg);
        border: none;
        padding: 0.75rem 1rem;
        border-radius: 10px;
    }
</style>
{% endblock %}
