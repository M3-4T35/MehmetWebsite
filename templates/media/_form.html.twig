<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            
            <div class="row mb-4">
                <div class="col-md-7">
                    <h5 class="section-title border-bottom pb-2 mb-3 text-primary">
                        <i class="bi bi-image me-2"></i>Fichier & Description
                    </h5>
                    {{ form_row(form.imageFile, {'label': 'Fichier Média', 'help': 'Images (jpg, png, webp) ou Vidéos (mp4)'}) }}
                    {{ form_row(form.alt, {'label': 'Texte Alternatif (Alt)', 'attr': {'placeholder': 'Description courte pour l\'accessibilité'}}) }}
                </div>
                <div class="col-md-5">
                    <h5 class="section-title border-bottom pb-2 mb-3 text-primary">
                        <i class="bi bi-gear me-2"></i>Paramètres
                    </h5>
                    {{ form_row(form.project, {'label': 'Projet Associé'}) }}
                    {{ form_row(form.position, {'label': 'Ordre d\'affichage'}) }}
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="{{ path('app_media_index') }}" class="btn btn-outline-secondary">Annuler</a>
                <button class="btn btn-primary px-4">
                    <i class="bi bi-check-circle me-1"></i> {{ button_label|default('Enregistrer') }}
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
