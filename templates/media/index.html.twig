{% extends 'base.html.twig' %}

{% block title %}Gestion des Médias{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-images me-2"></i>Gestion des Médias</h1>
        <a href="{{ path('app_media_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nouveau Média
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 100px;">Aperçu</th>
                        <th>Nom / Alt</th>
                        <th>Projet</th>
                        <th>Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for medium in media %}
                    <tr>
                        <td class="ps-4">
                            {% set ext = medium.filename|split('.')|last|lower %}
                            {% if ext in ['jpg','jpeg','png','gif','webp'] %}
                                <img src="{{ asset('uploads/media/' ~ medium.filename) }}" alt="{{ medium.alt }}" class="rounded shadow-sm" style="width: 60px; height: 60px; object-fit: cover;">
                            {% else %}
                                <div class="bg-light rounded d-flex align-items-center justify-content-center shadow-sm" style="width: 60px; height: 60px;">
                                    <i class="bi bi-file-earmark-play fs-3 text-secondary"></i>
                                </div>
                            {% endif %}
                        </td>
                        <td>
                            <div class="fw-bold">{{ medium.filename }}</div>
                            <small class="text-muted">{{ medium.alt ?: 'Sans texte alternatif' }}</small>
                        </td>
                        <td>
                            {% if medium.project %}
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                    <i class="bi bi-folder me-1"></i>{{ medium.project.title }}
                                </span>
                            {% else %}
                                <span class="text-muted small">Aucun projet</span>
                            {% endif %}
                        </td>
                        <td>
                            <small class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>{{ medium.createdAt ? medium.createdAt|date('d/m/Y') : 'N/A' }}
                            </small>
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a href="{{ path('app_media_show', {'id': medium.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_media_edit', {'id': medium.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="bi bi-images text-muted display-4 d-block mb-3"></i>
                            <span class="text-muted">Aucun média trouvé.</span>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
