{% extends 'base.html.twig' %}

{% block title %}Détails du Projet - {{ project.title }}{% endblock %}

{% block body %}
    <div class="mb-4 d-flex justify-content-between align-items-start">
        <div>
            <h1><i class="bi bi-info-circle me-2"></i>Détails du Projet</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_project_index') }}">Projets</a></li>
                    <li class="breadcrumb-item active">{{ project.title }}</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i> Modifier
            </a>
            {{ include('project/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-justify-left me-2"></i>Contenu (FR)
                </div>
                <div class="card-body">
                    <h5 class="text-primary">{{ project.title }}</h5>
                    <p class="text-muted small">{{ project.descriptionCourte }}</p>
                    <hr>
                    <div id="markdown-display-fr" class="markdown-body"></div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-translate me-2"></i>Content (EN)
                </div>
                <div class="card-body">
                    <h5 class="text-primary">{{ project.titleEn ?: 'Non traduit' }}</h5>
                    <p class="text-muted small">{{ project.descriptionCourteEn ?: 'No translation' }}</p>
                    <hr>
                    <div id="markdown-display-en" class="markdown-body">
                        {% if not project.descriptionEn %}
                            <span class="text-muted">Aucune description en anglais.</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light fw-bold">
                    <i class="bi bi-link-45deg me-2"></i>Informations & Liens
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="small text-muted d-block">GitHub</label>
                        {% if project.githubUrl %}
                            <a href="{{ project.githubUrl }}" target="_blank" class="text-decoration-none">
                                <i class="bi bi-github me-1"></i> {{ project.githubUrl }}
                            </a>
                        {% else %}
                            <span class="text-muted small">Non renseigné</span>
                        {% endif %}
                    </div>
                    <div class="mb-3">
                        <label class="small text-muted d-block">Production</label>
                        {% if project.productionUrl %}
                            <a href="{{ project.productionUrl }}" target="_blank" class="text-decoration-none text-info">
                                <i class="bi bi-globe me-1"></i> {{ project.productionUrl }}
                            </a>
                        {% else %}
                            <span class="text-muted small">Non renseigné</span>
                        {% endif %}
                    </div>
                    <hr>
                    <div class="small">
                        <p class="mb-1"><span class="text-muted">Créé le :</span> {{ project.createdAt|date('d/m/Y H:i') }}</p>
                        <p class="mb-0"><span class="text-muted">Dernière MàJ :</span> {{ project.updatedAt ? project.updatedAt|date('d/m/Y H:i') : 'Jamais' }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-2">
        <a href="{{ path('app_project_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
        </a>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const frContent = {{ project.description|json_encode|raw }};
            const enContent = {{ project.descriptionEn|json_encode|raw }};
            
            if (frContent) {
                document.getElementById('markdown-display-fr').innerHTML = marked.parse(frContent);
            }
            if (enContent) {
                document.getElementById('markdown-display-en').innerHTML = marked.parse(enContent);
            }
        });
    </script>
{% endblock %}
