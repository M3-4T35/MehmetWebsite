{% extends 'base.html.twig' %}

{% block title %}Project{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const markdownContent = {{ project.description|json_encode|raw }};
            const preview = document.getElementById('markdown-display');
            if (preview && markdownContent) {
                preview.innerHTML = marked.parse(markdownContent);
            }
        });
    </script>
{% endblock %}

{% block body %}
    <h1>Project</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ project.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ project.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td id="markdown-display"></td>
            </tr>
            <tr>
                <th>GithubUrl</th>
                <td>{{ project.githubUrl }}</td>
            </tr>
            <tr>
                <th>ProductionUrl</th>
                <td>{{ project.productionUrl }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ project.createdAt ? project.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ project.updatedAt ? project.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_project_index') }}" class="btn btn-secondary">back to list</a>

    <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-primary">edit</a>

    {{ include('project/_delete_form.html.twig') }}
{% endblock %}
