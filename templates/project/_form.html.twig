{% block stylesheets %}
    <style>
        .markdown-editor-container {
            border: 1px solid var(--bs-border-color);
            border-radius: 8px;
            overflow: hidden;
        }
        .markdown-preview-area {
            background-color: var(--bs-tertiary-bg);
            border-left: 1px solid var(--bs-border-color);
        }
        #markdown-preview, #markdown-preview-en {
            min-height: 250px;
            max-height: 500px;
            overflow-y: auto;
            padding: 1rem;
        }
        .section-title {
            border-bottom: 2px solid var(--bs-primary);
            padding-bottom: 0.5rem;
            margin-bottom: 1.5rem;
            font-size: 1.1rem;
            color: var(--bs-primary);
        }
    </style>
{% endblock %}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        {{ form_start(form) }}
            
            <div class="row mb-4">
                <div class="col-md-6">
                    <h5 class="section-title"><i class="bi bi-translate me-2"></i>Contenu Français</h5>
                    {{ form_row(form.title) }}
                    {{ form_row(form.descriptionCourte) }}
                    <div class="mb-3">
                        {{ form_label(form.description) }}
                        <div class="markdown-editor-container d-flex flex-column flex-lg-row">
                            <div class="flex-grow-1">
                                {{ form_widget(form.description, {'attr': {'class': 'form-control border-0 rounded-0', 'style': 'height: 300px;'}}) }}
                            </div>
                            <div class="markdown-preview-area flex-grow-1">
                                <div class="p-2 border-bottom small text-muted bg-body-tertiary"><i class="bi bi-eye me-1"></i>Aperçu FR</div>
                                <div id="markdown-preview"></div>
                            </div>
                        </div>
                        {{ form_errors(form.description) }}
                    </div>
                </div>
                
                <div class="col-md-6">
                    <h5 class="section-title"><i class="bi bi-translate me-2"></i>English Content</h5>
                    {{ form_row(form.titleEn) }}
                    {{ form_row(form.descriptionCourteEn) }}
                    <div class="mb-3">
                        {{ form_label(form.descriptionEn) }}
                        <div class="markdown-editor-container d-flex flex-column flex-lg-row">
                            <div class="flex-grow-1">
                                {{ form_widget(form.descriptionEn, {'attr': {'class': 'form-control border-0 rounded-0', 'style': 'height: 300px;'}}) }}
                            </div>
                            <div class="markdown-preview-area flex-grow-1">
                                <div class="p-2 border-bottom small text-muted bg-body-tertiary"><i class="bi bi-eye me-1"></i>EN Preview</div>
                                <div id="markdown-preview-en"></div>
                            </div>
                        </div>
                        {{ form_errors(form.descriptionEn) }}
                    </div>
                </div>
            </div>

            <h5 class="section-title"><i class="bi bi-link-45deg me-2"></i>Liens & Métadonnées</h5>
            <div class="row mb-4">
                <div class="col-md-6">
                    {{ form_row(form.githubUrl, {'attr': {'placeholder': 'https://github.com/...'}}) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.productionUrl, {'attr': {'placeholder': 'https://...'}}) }}
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a href="{{ path('app_project_index') }}" class="btn btn-outline-secondary">Annuler</a>
                <button class="btn btn-primary px-4">{{ button_label|default('Enregistrer') }}</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Function to setup preview for a textarea and preview div
            function setupPreview(textareaId, previewId) {
                const textarea = document.getElementById(textareaId);
                const preview = document.getElementById(previewId);
                
                function updatePreview() { 
                    if(textarea && preview) {
                        preview.innerHTML = marked.parse(textarea.value); 
                    }
                }
                
                if (textarea) { 
                    textarea.addEventListener('input', updatePreview); 
                    updatePreview(); 
                }
            }

            setupPreview('project_description', 'markdown-preview');
            setupPreview('project_descriptionEn', 'markdown-preview-en');
        });
    </script>
{% endblock %}
