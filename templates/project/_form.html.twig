{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Target the specific textarea for the description
            const textarea = document.getElementById('project_description');
            const preview = document.getElementById('markdown-preview');
            
            function updatePreview() { 
                if(textarea && preview) {
                    preview.innerHTML = marked.parse(textarea.value); 
                }
            }
            
            if (textarea) { 
                textarea.addEventListener('input', updatePreview); 
                updatePreview(); // Initial render
            }
        });
    </script>
{% endblock %}

{% block stylesheets %}
    <style>
        .markdown-editor-container {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }
        .markdown-editor-container > div {
            flex: 1;
        }
        #markdown-preview {
            border: 1px solid #ccc;
            padding: 15px;
            background: #fafafa;
            border-radius: 4px;
            min-height: 250px;
            overflow-y: auto;
            max-height: 500px;
        }
        #markdown-preview code { 
            background: #272822; 
            padding: 2px 4px; 
            border-radius: 4px; 
            font-family: monospace; 
            color: #f8f8f2; 
        }
        #markdown-preview pre { 
            background: #272822; 
            color: #f8f8f2; 
            padding: 12px; 
            border-radius: 6px; 
            overflow-x: auto; 
            margin-bottom: 1em; 
        }
        #markdown-preview pre code { 
            margin: 0; 
            padding: 0; 
            background: transparent;
            max-width: 100%; 
            word-break: break-word; 
            white-space: pre-wrap; 
        }
        #markdown-preview blockquote { 
            border-left: 4px solid #ccc; 
            padding: 0.5em 1em; 
            margin: 0 0 1em 0; 
            background: #fdfdfd;
        }
    </style>
{% endblock %}

{{ form_start(form) }}
    {# Render the title normally #}
    {{ form_row(form.title) }}

    {# Custom rendering for the Markdown description field #}
    <div class="mb-3">
        {{ form_label(form.description) }}
        <div class="markdown-editor-container">
            <div>
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>
            <div>
                <div id="markdown-preview"></div>
            </div>
        </div>
    </div>

    {# Render the rest of the form fields #}
    {{ form_rest(form) }}
    
    <button class="btn btn-primary mt-3">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
