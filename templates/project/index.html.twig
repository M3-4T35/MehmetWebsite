{% extends 'base.html.twig' %}

{% block title %}Gestion des Projets{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-kanban me-2"></i>Gestion des Projets</h1>
        <a href="{{ path('app_project_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nouveau Projet
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Projet</th>
                        <th>URLs</th>
                        <th>Dates</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for project in projects %}
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-primary">{{ project.title }}</div>
                            <small class="text-muted d-block text-truncate" style="max-width: 300px;">
                                {{ project.descriptionCourte }}
                            </small>
                        </td>
                        <td>
                            {% if project.githubUrl %}
                                <a href="{{ project.githubUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-dark mb-1" title="GitHub">
                                    <i class="bi bi-github"></i>
                                </a>
                            {% endif %}
                            {% if project.productionUrl %}
                                <a href="{{ project.productionUrl }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-info mb-1" title="Production">
                                    <i class="bi bi-globe"></i>
                                </a>
                            {% endif %}
                        </td>
                        <td>
                            <div class="small">
                                <span class="text-muted">Créé :</span> {{ project.createdAt|date('d/m/Y') }}<br>
                                {% if project.updatedAt %}
                                    <span class="text-muted">Màj :</span> {{ project.updatedAt|date('d/m/Y') }}
                                {% endif %}
                            </div>
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a href="{{ path('app_project_show', {'id': project.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_project_edit', {'id': project.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="text-center py-5">
                            <i class="bi bi-inbox text-muted display-4 d-block mb-3"></i>
                            <span class="text-muted">Aucun projet trouvé.</span>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
