{% extends 'base.html.twig' %}

{% block title %}{{ 'legal.title'|trans }}{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="fw-bold mb-4">{{ 'legal.title'|trans }}</h1>
    <div class="card shadow-sm border-0 p-4 bg-body-tertiary rounded-4">
        <p class="lead mb-4">{{ 'legal.intro'|trans }}</p>
        
        <h3 class="h5 fw-bold text-primary mb-3">{{ 'legal.host.title'|trans }}</h3>
        <ul class="list-unstyled mb-4">
            <li class="mb-2">{{ 'legal.host.name'|trans }}</li>
            <li class="mb-2">{{ 'legal.host.domain'|trans }}</li>
            <li class="mb-2">{{ 'legal.host.contact'|trans }} <a href="mailto:mehmet.ates.pro@outlook.fr" class="text-decoration-none">mehmet.ates.pro@outlook.fr</a></li>
            <li class="mb-2">{{ 'legal.host.details'|trans }}</li>
        </ul>
        
        <p class="mb-3"><i class="bi bi-shield-check me-2 text-success"></i>{{ 'legal.data'|trans }}</p>
        <p class="text-muted small">{{ 'legal.contact_info'|trans }}</p>
    </div>
</div>
{% endblock %}
