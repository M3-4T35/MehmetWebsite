{% extends 'base.html.twig' %}

{% block title %}CV{% endblock %}

{% block body %}
    <h1>CV</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ c_v.id }}</td>
            </tr>
            <tr>
                <th>Filename</th>
                <td>{{ c_v.filename }}</td>
            </tr>
            <tr>
                <th>UploadedAt</th>
                <td>{{ c_v.uploadedAt ? c_v.uploadedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_c_v_index') }}">back to list</a>

    <a href="{{ path('app_c_v_edit', {'id': c_v.id}) }}">edit</a>

    {{ include('cv/_delete_form.html.twig') }}
{% endblock %}
