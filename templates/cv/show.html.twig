{% extends 'base.html.twig' %}

{% block title %}Détails du CV{% endblock %}

{% block body %}
    <div class="mb-4 d-flex justify-content-between align-items-start">
        <div>
            <h1><i class="bi bi-info-circle me-2"></i>Détails du CV</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_c_v_index') }}">CV</a></li>
                    <li class="breadcrumb-item active">{{ c_v.filename }}</li>
                </ol>
            </nav>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_c_v_edit', {'id': c_v.id}) }}" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i> Modifier
            </a>
            {{ include('cv/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
                    <span class="fw-bold">Aperçu du PDF</span>
                    <a href="{{ asset('uploads/cv/' ~ c_v.filename) }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Ouvrir plein écran
                    </a>
                </div>
                <div class="card-body p-0">
                    <div style="height: 600px;">
                        <iframe src="{{ asset('uploads/cv/' ~ c_v.filename) }}" width="100%" height="100%" style="border:none;"></iframe>
                    </div>
                </div>
                <div class="card-footer bg-body-tertiary text-muted small">
                    <i class="bi bi-calendar-event me-1"></i> Téléversé le : {{ c_v.uploadedAt ? c_v.uploadedAt|date('d/m/Y H:i') : 'N/A' }}
                </div>
            </div>
        </div>
    </div>

    <div class="mt-2">
        <a href="{{ path('app_c_v_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Retour à la liste
        </a>
    </div>
{% endblock %}
