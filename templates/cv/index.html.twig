{% extends 'base.html.twig' %}

{% block title %}Gestion des CV{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-file-earmark-pdf me-2"></i>Gestion des CV</h1>
        <a href="{{ path('app_c_v_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nouveau CV
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Fichier</th>
                        <th>Date d'ajout</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for c_v in c_vs %}
                    <tr>
                        <td class="ps-4">
                            <a href="{{ asset('uploads/cv/' ~ c_v.filename) }}" target="_blank" class="text-decoration-none fw-bold">
                                <i class="bi bi-file-pdf text-danger me-2"></i>{{ c_v.filename }}
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-calendar-event me-1"></i>
                                {{ c_v.uploadedAt ? c_v.uploadedAt|date('d/m/Y H:i') : 'N/A' }}
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <a href="{{ path('app_c_v_show', {'id': c_v.id}) }}" class="btn btn-sm btn-outline-secondary" title="Voir">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ path('app_c_v_edit', {'id': c_v.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center py-5">
                            <i class="bi bi-file-earmark-x text-muted display-4 d-block mb-3"></i>
                            <span class="text-muted">Aucun CV trouvé.</span>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
