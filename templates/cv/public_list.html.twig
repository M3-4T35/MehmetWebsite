{% extends 'base.html.twig' %}

{% block title %}{{ 'menu.cvs'|trans }} | Mehmet ATES{% endblock %}

{% block body %}
<div class="hero-section text-center px-3">
    <h1 class="display-4 fw-bold mb-3">{{ 'cvs.list.title'|trans }}</h1>
    <p class="lead text-muted mx-auto" style="max-width: 700px;">
        {{ 'cvs.list.text'|trans }}
    </p>
</div>

<div class="row g-4 justify-content-center">
    {% for cv in cvs %}
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm border-0 project-card p-2">
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="bi bi-file-earmark-person display-1 text-primary opacity-50"></i>
                    </div>
                    
                    <h4 class="card-title fw-bold mb-2">
                        {{ cv.title ?: 'cvs.list.label_default'|trans }}
                    </h4>
                    
                    <p class="text-muted small mb-4">
                        <i class="bi bi-calendar-check me-1"></i>
                        {{ 'cvs.list.updated_at'|trans }} {{ cv.uploadedAt ? cv.uploadedAt|date('d/m/Y') : 'N/A' }}
                    </p>

                    <div class="d-grid gap-2">
                        {% if cv.filename %}
                            <a href="{{ asset('uploads/cv/' ~ cv.filename) }}" class="btn btn-primary rounded-pill px-4" target="_blank" rel="noopener noreferrer">
                                <i class="bi bi-download me-2"></i>{{ 'cvs.list.download'|trans }}
                            </a>
                            <button class="btn btn-outline-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#cvModal{{ cv.id }}">
                                <i class="bi bi-eye me-2"></i>{{ 'cvs.list.view_online'|trans }}
                            </button>
                        {% else %}
                            <div class="alert alert-warning py-2 small mb-0">
                                <i class="bi bi-exclamation-triangle me-1"></i>{{ 'cvs.list.not_available'|trans }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# Modal moved outside the card div to prevent overflow/rendering issues #}
        {% if cv.filename %}
            <div class="modal fade" id="cvModal{{ cv.id }}" tabindex="-1" aria-labelledby="cvModalLabel{{ cv.id }}" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content shadow-lg border-0">
                        <div class="modal-header border-0 bg-body-tertiary">
                            <h5 class="modal-title fw-bold" id="cvModalLabel{{ cv.id }}">
                                <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>{{ 'cvs.list.modal_title'|trans }}
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-0" style="height: 80vh;">
                            <object data="{{ asset('uploads/cv/' ~ cv.filename) }}" type="application/pdf" width="100%" height="100%">
                                <div class="p-5 text-center">
                                    <p class="lead">{{ 'cvs.list.modal_fallback'|trans }}</p>
                                    <a href="{{ asset('uploads/cv/' ~ cv.filename) }}" class="btn btn-primary rounded-pill" target="_blank" rel="noopener noreferrer">
                                        {{ 'cvs.list.modal_open_new'|trans }}
                                    </a>
                                </div>
                            </object>
                        </div>
                        <div class="modal-footer border-0 bg-body-tertiary">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">{{ 'cvs.list.modal_close'|trans }}</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% else %}
        <div class="col-12 text-center py-5">
            <i class="bi bi-file-earmark-x text-muted display-1"></i>
            <p class="mt-3 text-muted">{{ 'cvs.list.empty'|trans }}</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
