{% extends 'base.html.twig' %}

{% block title %}Mes CV{% endblock %}

{% block body %}
<div class="hero-section text-center px-3">
    <h1 class="display-4 fw-bold mb-3">Curriculum Vitae</h1>
    <p class="lead text-muted mx-auto" style="max-width: 700px;">
        Consultez mes différents CV pour en savoir plus sur mon expérience, 
        mes compétences techniques et mon parcours académique.
    </p>
</div>

<div class="row g-4 justify-content-center">
    {% for cv in cvs %}
        <div class="col-md-6 col-lg-5">
            <div class="card h-100 shadow-sm border-0 project-card p-2">
                <div class="card-body text-center">
                    <div class="mb-4">
                        <i class="bi bi-file-earmark-person display-1 text-primary opacity-50"></i>
                    </div>
                    
                    <h4 class="card-title fw-bold mb-2">
                        {{ cv.title ?: 'Curriculum Vitae' }}
                    </h4>
                    
                    <p class="text-muted small mb-4">
                        <i class="bi bi-calendar-check me-1"></i>
                        Mis à jour le {{ cv.uploadedAt ? cv.uploadedAt|date('d/m/Y') : 'N/A' }}
                    </p>

                    <div class="d-grid gap-2">
                        {% if cv.filename %}
                            <a href="{{ asset('uploads/cv/' ~ cv.filename) }}" class="btn btn-primary rounded-pill px-4" target="_blank">
                                <i class="bi bi-download me-2"></i>Télécharger le PDF
                            </a>
                            <button class="btn btn-outline-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#cvModal{{ cv.id }}">
                                <i class="bi bi-eye me-2"></i>Consulter en ligne
                            </button>
                        {% else %}
                            <div class="alert alert-warning py-2 small mb-0">
                                <i class="bi bi-exclamation-triangle me-1"></i>Fichier non disponible
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# Modal moved outside the card div to prevent overflow/rendering issues #}
        {% if cv.filename %}
            <div class="modal fade" id="cvModal{{ cv.id }}" tabindex="-1" aria-labelledby="cvModalLabel{{ cv.id }}" aria-hidden="true">
                <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                    <div class="modal-content shadow-lg border-0">
                        <div class="modal-header border-0 bg-light">
                            <h5 class="modal-title fw-bold" id="cvModalLabel{{ cv.id }}">
                                <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>{{ cv.title ?: 'Curriculum Vitae' }}
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-0" style="height: 80vh;">
                            <object data="{{ asset('uploads/cv/' ~ cv.filename) }}" type="application/pdf" width="100%" height="100%">
                                <div class="p-5 text-center">
                                    <p class="lead">Votre navigateur ne peut pas afficher le PDF directement.</p>
                                    <a href="{{ asset('uploads/cv/' ~ cv.filename) }}" class="btn btn-primary rounded-pill" target="_blank">
                                        Ouvrir le PDF dans un nouvel onglet
                                    </a>
                                </div>
                            </object>
                        </div>
                        <div class="modal-footer border-0 bg-light">
                            <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Fermer</button>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% else %}
        <div class="col-12 text-center py-5">
            <i class="bi bi-file-earmark-x text-muted display-1"></i>
            <p class="mt-3 text-muted">Aucun CV disponible pour le moment.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
