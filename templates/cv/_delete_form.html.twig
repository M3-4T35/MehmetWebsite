<form method="post" action="{{ path('app_c_v_delete', {'id': c_v.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce CV ?');" style="display:inline-block">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ c_v.id) }}">
    <button class="btn btn-outline-danger">
        <i class="bi bi-trash me-1"></i> Supprimer
    </button>
</form>
