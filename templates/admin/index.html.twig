{% extends 'base.html.twig' %}

{% block title %}Administration | MehmetAtes.fr{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0"><i class="bi bi-shield-lock me-2 text-primary"></i>Dashboard Admin</h1>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <i class="bi bi-folder2-open display-5 text-primary"></i>
                    <h5 class="fw-bold mt-3 mb-1">Projets</h5>
                    <p class="text-muted small">Créer, modifier et publier les projets du portfolio.</p>
                    <a href="{{ path('app_project_index') }}" class="btn btn-outline-primary btn-sm rounded-pill px-3">Gérer</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <i class="bi bi-images display-5 text-primary"></i>
                    <h5 class="fw-bold mt-3 mb-1">Médias</h5>
                    <p class="text-muted small">Téléverser images et vidéos, définir l'ordre d'affichage.</p>
                    <a href="{{ path('app_media_index') }}" class="btn btn-outline-primary btn-sm rounded-pill px-3">Gérer</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body text-center p-4">
                    <i class="bi bi-file-earmark-person display-5 text-primary"></i>
                    <h5 class="fw-bold mt-3 mb-1">CV</h5>
                    <p class="text-muted small">Publier et mettre à jour les versions du CV en PDF.</p>
                    <a href="{{ path('app_c_v_index') }}" class="btn btn-outline-primary btn-sm rounded-pill px-3">Gérer</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
