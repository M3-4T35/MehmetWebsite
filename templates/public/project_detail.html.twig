{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        /* Inline code */
        code {
            background: #272822;
            padding: 2px 4px;
            border-radius: 4px;
            font-family: "Fira Mono", "Consolas", "Monaco", monospace;
            font-size: 0.95em;
            color: #f8f8f2 !important;
        }

        /* Code blocks */ 
        #markdown pre {
            background: #272822;
            color: #f8f8f2;
            padding: 12px;
            border-radius: 6px;
            overflow-x: auto;
            font-family: "Fira Mono", "Consolas", "Monaco", monospace;
            font-size: 0.95em;
            margin-bottom: 1em;
        }

        /* supprime l'alinéa */
        #markdown pre code {
            margin: 0;
            padding: 0;
            max-width: 100%;
            word-break: break-word;
            white-space: pre-wrap;
        }

        blockquote {
            border-left: 4px solid #ccc;
            padding: 0.5em 1em;
            margin: 0;
        }
        blockquote p {
            margin: 0;
        }

        #markdown {
            color: #555;
            /* white-space: pre-wrap; */
            word-break: break-word;
            max-width: 100%;
        }
        
    </style>
{% endblock %}

{% block title %}
    {% if app.request.locale == 'en' and project.titleEn %}
        {{ project.titleEn }}
    {% else %}
        {{ project.title }}
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const markdownContent = {% if app.request.locale == 'en' and project.descriptionEn %}{{ project.descriptionEn|json_encode|raw }}{% else %}{{ project.description|json_encode|raw }}{% endif %};
            const preview = document.getElementById('markdown-display');
            if (preview && markdownContent) {
                preview.innerHTML = marked.parse(markdownContent);
            }
        });
    </script>
{% endblock %}

{% block body %}
<h1>
    {% if app.request.locale == 'en' and project.titleEn %}
        {{ project.titleEn }}
    {% else %}
        {{ project.title }}
    {% endif %}
</h1>
<p class="lead">
    {% if app.request.locale == 'en' and project.descriptionCourteEn %}
        {{ project.descriptionCourteEn }}
    {% else %}
        {{ project.descriptionCourte }}
    {% endif %}
</p>

<h3>Description : </h3>
<div class="mb-4" id="markdown-display">
    {# The markdown content will be injected here by marked.js #}
</div>

<h3>Médias</h3>
<div class="row">
    {% for media in medias %}
        <div class="col-md-4 mb-3">
            {% set ext = media.filename|split('.')|last|lower %}
            {% if ext in ['jpg','jpeg','png','gif','webp'] %}
                <img src="{{ asset('uploads/media/' ~ media.filename) }}" alt="{{ media.alt }}" class="img-fluid rounded shadow">
            {% elseif ext in ['mp4','webm','ogg'] %}
                <video controls class="w-100">
                    <source src="{{ asset('uploads/media/' ~ media.filename) }}" type="video/{{ ext }}">
                    Votre navigateur ne supporte pas la vidéo.
                </video>
            {% endif %}
        </div>
    {% else %}
        <p>Aucun média pour ce projet.</p>
    {% endfor %}
</div>
<a href="{{ path('app_public_projects') }}" class="btn btn-secondary mt-4">Retour à la liste</a>
{% endblock %}