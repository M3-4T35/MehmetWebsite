{% extends 'base.html.twig' %}

{% block title %}{{ 'menu.projects'|trans }}{% endblock %}

{% block body %}
<h1>{{ 'menu.projects'|trans }}</h1>
<div class="row">
    {% for project in projects %}
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">{{ project.title }}</h5>
                    <div class="card-text">{{ project.descriptionCourte }}</div>
                    <a href="{{ path('app_public_project_detail', {'id': project.id}) }}" class="btn btn-outline-success btn-sm mt-2">Voir plus</a>
                </div>
            </div>
        </div>
    {% else %}
        <p>Aucun projet publié pour le moment.</p>
    {% endfor %}
</div>
{% endblock %}