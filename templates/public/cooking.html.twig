{% extends 'base.html.twig' %}

{% block title %}{{ 'cooking.title'|trans }} | Mehmet ATES{% endblock %}

{% block meta_description %}{{ 'cooking.text'|trans }}{% endblock %}

{% block stylesheets %}
    <style>
        .dish-card .dish-media {
            aspect-ratio: 4 / 3;
            overflow: hidden;
            background: var(--bs-tertiary-bg);
            position: relative;
        }
        .dish-card .dish-media img,
        .dish-card .dish-media video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.5s ease;
        }
        .dish-card:hover .dish-media img {
            transform: scale(1.06);
        }
        .dish-card .dish-open {
            cursor: zoom-in;
            border: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background: none;
        }
        .dish-video-badge {
            position: absolute;
            top: 0.75rem;
            right: 0.75rem;
            pointer-events: none;
        }
        #dishModal .modal-body img,
        #dishModal .modal-body video {
            max-height: 75vh;
            max-width: 100%;
            object-fit: contain;
        }
    </style>
{% endblock %}

{% block body %}
<div class="hero-section text-center px-3">
    <i class="bi bi-egg-fried display-4 text-primary"></i>
    <h1 class="display-4 fw-bold mb-3">{{ 'cooking.title'|trans }}</h1>
    <p class="lead text-muted mx-auto" style="max-width: 700px;">
        {{ 'cooking.text'|trans }}
    </p>
</div>

<div class="row g-4">
    {% for dish in dishes %}
        {% set title = app.request.locale == 'en' and dish.titleEn ? dish.titleEn : dish.title %}
        {% set description = app.request.locale == 'en' and dish.descriptionEn ? dish.descriptionEn : dish.description %}
        {% set src = asset('uploads/cuisine/' ~ dish.filename) %}
        <div class="col-sm-6 col-lg-4">
            <article class="card h-100 shadow-sm project-card dish-card">
                <div class="dish-media">
                    {% if dish.video %}
                        <video controls preload="metadata" playsinline aria-label="{{ title }}">
                            <source src="{{ src }}" type="{{ dish.videoMimeType }}">
                        </video>
                        <span class="badge text-bg-dark dish-video-badge"><i class="bi bi-play-fill me-1" aria-hidden="true"></i>{{ 'cooking.video'|trans }}</span>
                    {% else %}
                        <button type="button" class="dish-open" data-bs-toggle="modal" data-bs-target="#dishModal"
                                data-dish-src="{{ src }}" data-dish-title="{{ title }}" data-dish-description="{{ description }}"
                                aria-label="{{ 'cooking.enlarge'|trans }} : {{ title }}">
                            <img src="{{ src }}" alt="{{ title }}" loading="lazy">
                        </button>
                    {% endif %}
                </div>
                <div class="card-body">
                    <h2 class="h5 card-title fw-bold mb-1">{{ title }}</h2>
                    {% if description %}
                        <p class="card-text text-muted small mb-0" style="white-space: pre-line;">{{ description }}</p>
                    {% endif %}
                </div>
            </article>
        </div>
    {% else %}
        <div class="col-12 text-center py-5">
            <i class="bi bi-egg text-muted display-1"></i>
            <p class="mt-3 text-muted">{{ 'cooking.empty'|trans }}</p>
        </div>
    {% endfor %}
</div>

<div class="text-center mt-5">
    <a href="{{ path('app_home') }}" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-2"></i>{{ 'cooking.back'|trans }}
    </a>
</div>

{# Single shared lightbox for photos, filled from the clicked card #}
<div class="modal fade" id="dishModal" tabindex="-1" aria-labelledby="dishModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0">
                <h2 class="modal-title h5 fw-bold" id="dishModalLabel"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'cvs.list.modal_close'|trans }}"></button>
            </div>
            <div class="modal-body pt-0 text-center">
                <img src="" alt="" class="rounded">
                <p class="text-muted mt-3 mb-0 text-start" style="white-space: pre-line;" id="dishModalDescription"></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById('dishModal');
            if (!modal) return;
            const img = modal.querySelector('.modal-body img');
            modal.addEventListener('show.bs.modal', function (event) {
                const trigger = event.relatedTarget;
                if (!trigger) return;
                img.src = trigger.dataset.dishSrc;
                img.alt = trigger.dataset.dishTitle;
                document.getElementById('dishModalLabel').textContent = trigger.dataset.dishTitle;
                document.getElementById('dishModalDescription').textContent = trigger.dataset.dishDescription || '';
            });
            modal.addEventListener('hidden.bs.modal', function () {
                img.removeAttribute('src');
            });
        });
    </script>
{% endblock %}
