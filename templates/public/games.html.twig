{% extends 'base.html.twig' %}

{% block title %}{{ 'games.title'|trans }} | Mehmet ATES{% endblock %}

{% block meta_description %}{{ 'games.text'|trans }}{% endblock %}

{% block stylesheets %}
    <style>
        .games-cta {
            font-size: 1.25rem;
            padding: 1rem 2rem;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .games-cta:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 12px 24px rgba(13, 110, 253, 0.3);
        }
        .games-cta .bi-controller {
            display: inline-block;
            transition: transform 0.3s ease;
        }
        .games-cta:hover .bi-controller {
            transform: rotate(-15deg);
        }
    </style>
{% endblock %}

{% block body %}
<div class="hero-section text-center px-3 py-5">
    <i class="bi bi-controller display-3 text-primary"></i>
    <h1 class="display-4 fw-bold mb-3">{{ 'games.title'|trans }}</h1>
    <p class="lead text-muted mx-auto mb-5" style="max-width: 700px;">
        {{ 'games.text'|trans }}
    </p>

    <a href="https://store.steampowered.com/app/48700/Mount_Blade_Warband/" target="_blank" rel="noopener noreferrer"
       class="btn btn-primary btn-lg rounded-pill games-cta">
        <i class="bi bi-controller me-2" aria-hidden="true"></i>{{ 'games.cta'|trans }}
        <i class="bi bi-box-arrow-up-right ms-2 small" aria-hidden="true"></i>
    </a>
    <p class="small text-muted mt-3 mb-0">{{ 'games.note'|trans }}</p>
</div>

<div class="text-center">
    <a href="{{ path('app_home') }}" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-2"></i>{{ 'games.back'|trans }}
    </a>
</div>
{% endblock %}
